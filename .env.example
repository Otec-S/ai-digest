# Ключ Anthropic API (обязателен)
ANTHROPIC_API_KEY=

# Telegram-бот и чат для отправки дайджестов (обязательны)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Brave Search API (опционально — без него шаг поиска пропускается)
BRAVE_API_KEY=

# Путь к файлу SQLite (по умолчанию ./data/digest.db)
DB_PATH=./data/digest.db

# Уровень логирования pino: trace|debug|info|warn|error|fatal
LOG_LEVEL=info
